# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"envirosese","private_key_id":"...","private_key":"...","client_email":"..."}

# === DeepSeek (IA Asistente) ===
# DEEPSEEK_API_KEY=sk-...
